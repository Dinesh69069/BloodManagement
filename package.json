{
  "name": "lifeline-blood-bank",
  "version": "2.0.0",
  "private": true,
  "description": "LifeLine blood donor and request coordination platform",
  "type": "module",
  "scripts": {
    "build": "echo 'No build step required'",
    "start": "node backend/src/server.js",
    "dev": "node --watch backend/src/server.js",
    "test": "node --test",
