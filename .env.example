# Application Port (Render / Railway / Heroku automatically injects PORT)
PORT=3000

# MongoDB Connection String (Atlas Replica Set or Local Replica Set)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/lifeline?retryWrites=true&w=majority
# Example Local: mongodb://127.0.0.1:27017/lifeline?replicaSet=rs0
MONGODB_URI=mongodb://127.0.0.1:27017/lifeline?replicaSet=rs0

# Session Secret (Must be a high-entropy string of at least 32 characters in production)
SESSION_SECRET=replace-this-with-a-long-random-secret-at-least-32-chars

# Environment Mode ('development' or 'production')
NODE_ENV=production

# Trust Proxy Hops (Set to 1 when deployed behind reverse proxies like Render, Railway, Cloudflare, or Nginx)
TRUST_PROXY_HOPS=1
